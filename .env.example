# --- Site ---------------------------------------------------------------
# Public address of this site; used for share images and links in emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional runtime server URL override for redirects and admin origin checks.
# If unset, the server uses NEXT_PUBLIC_SITE_URL from the build.
# APP_URL=https://alfreed.space

# --- Database (MongoDB) -------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=alfred

# --- Auth ---------------------------------------------------------------
# At least 32 random characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=
# Credits a new account starts with.
STARTER_CREDITS=10
# Extension origins allowed to call the API in production, comma separated.
# In development any chrome-extension:// origin is allowed.
EXTENSION_ORIGINS=chrome-extension://your-extension-id

# --- AI (credits mode) --------------------------------------------------
# Alfred's own DeepSeek key (platform.deepseek.com). Users on their own keys never touch it.
DEEPSEEK_API_KEY=
# Optional. The DeepSeek model for credits mode; defaults to deepseek-flash
# (fast enough for a side panel; deepseek-v4-pro is several times slower).
DEEPSEEK_MODEL=deepseek-flash

# --- Administration & transactional email -------------------------------
# This inbox becomes the protected owner after registration email verification.
ADMIN_EMAIL=admin@alfreed.space
# Resend API key and a sender on a verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=Alfred <auth@alfreed.space>
# MongoDB must support transactions (Atlas or a local replica set).

# Email: admin@alfreed.space
# Password: CzHwoNorI_H300JgepyAgjAvoHwxcOuA
