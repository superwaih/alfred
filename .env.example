# --- Site ---------------------------------------------------------------
# Public address of this site; used for share images and checkout return links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (MongoDB) -------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=alfred

# --- Auth ---------------------------------------------------------------
# At least 32 random characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=
# Credits a new account starts with.
STARTER_CREDITS=10
# Extension origins allowed to call the API in production, comma separated.
# In development any chrome-extension:// origin is allowed.
EXTENSION_ORIGINS=chrome-extension://your-extension-id

# --- AI (credits mode) --------------------------------------------------
# Alfred's own DeepSeek key (platform.deepseek.com). Users on their own keys never touch it.
DEEPSEEK_API_KEY=
# Optional. The DeepSeek model for credits mode; defaults to deepseek-flash
# (fast enough for a side panel; deepseek-v4-pro is several times slower).
DEEPSEEK_MODEL=deepseek-flash

# --- Payments (Polar) ---------------------------------------------------
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# sandbox or production
POLAR_ENVIRONMENT=sandbox
# One entry per credit pack: a Polar product id and how many credits it buys.
POLAR_CREDIT_PACKS=[{"id":"small","productId":"","credits":30,"label":"30 credits","price":"$5"},{"id":"large","productId":"","credits":100,"label":"100 credits","price":"$14"}]
